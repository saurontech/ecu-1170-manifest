FROM ubuntu:24.04

ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
ENV TZ=Asia/Shanghai

# Install Yocto build dependencies, generate locale, clean apt cache
RUN DEBIAN_FRONTEND=noninteractive apt-get update && apt-get install -y --no-install-recommends \
    build-essential chrpath cpio debianutils diffstat file \
    gawk gcc g++ git git-lfs iputils-ping \
    libacl1 libcrypt-dev liblz4-tool locales \
    python3 python3-git python3-jinja2 python3-pexpect \
    python3-pip python3-subunit \
    socat texinfo unzip wget xz-utils zstd \
    repo ca-certificates curl openssh-client rsync \
    make cmake ninja-build pkg-config bc bison flex patch \
    tar gzip bzip2 lz4 \
    libssl-dev libncurses-dev libelf-dev \
    xterm \
    vim less tree jq procps psmisc lsof strace net-tools \
    ccache sudo \
    && locale-gen en_US.UTF-8 \
    && git lfs install --system \
    && rm -rf /var/lib/apt/lists/*

# Host UID/GID passed at build time, for mount volume file permission alignment
ARG USER_ID=1000
ARG GROUP_ID=1000

RUN \
# Modify built‑in ubuntu user uid; ignore error if target uid is already occupied
usermod -u ${USER_ID} ubuntu 2>/dev/null || true \
# Modify built‑in ubuntu user gid; ignore error if target gid is already occupied
&& groupmod -g ${GROUP_ID} ubuntu 2>/dev/null || true \
# Configure password‑less sudo for ubuntu user
&& echo "ubuntu ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/ubuntu \
&& chmod 0440 /etc/sudoers.d/ubuntu

# Switch to non‑root ubuntu user
USER ubuntu
WORKDIR /working
CMD ["/bin/bash"]
